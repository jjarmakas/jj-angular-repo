<#
    Copy-WASHistoricalLogs.ps1

    Continuously watches a WebSphere JVM log directory (SystemOut/SystemErr with
    "Log File Rotation by File Size", Maximum Historical Log Files = 10) and ships
    any historical (already-rotated) log file to a Windows file share, so the
    archive is not limited to the 10 files WAS keeps on local disk.

    DESIGN NOTES (why it looks like this):
      - Polls in-process every N seconds instead of being re-launched every second
        by Task Scheduler. Task Scheduler's minimum reliable trigger granularity is
        1 minute, and spawning a new powershell.exe process every second is heavy
        and fragile. Instead this script starts once and loops forever internally.
      - Never copies the two files WAS is actively writing to (SystemOut.log /
        SystemErr.log) - only files that have already been rotated out.
      - Every loop iteration is wrapped in try/catch so a transient error (share
        offline, file mid-rename, permission blip) never kills the process - it
        just logs and retries next second. Process-level survival (in case of a
        crash/OOM) is the job of the service wrapper - see bottom of file for
        deployment notes.
      - A named Mutex prevents two copies of the script running at once, which
        matters a lot when the "run every second" requirement invites double
        starts from a scheduler misconfiguration.
      - Uses a cheap in-memory cache keyed by "name+size" so unchanged files are
        never re-stat'd across the network on every 1-second tick - only new or
        changed files trigger a robocopy.
      - Actual file transfer is delegated to robocopy for its restartable /Z mode
        and built-in retry against flaky network shares; the PowerShell loop only
        decides *when* a copy is needed.
      - If a destination file with the same name but different size already
        exists (WAS can reuse historical file names across rotations), the
        existing destination copy is archived with a timestamp suffix first, so
        no historical content is ever silently overwritten.
#>

[CmdletBinding()]
param(
    # Directory containing the JVM's SystemOut.log / SystemErr.log and their
    # rotated historical siblings, e.g. C:\WebSphere\AppServer\profiles\<profile>\logs\<server>
    [Parameter(Mandatory = $true)]
    [string]$SourcePath,

    # UNC path to the destination share, e.g. \\fileshare\WASLogArchive
    [Parameter(Mandatory = $true)]
    [string]$DestinationPath,

    # File names that are the *live* logs and must never be copied.
    [string[]]$ExcludeFileNames = @('SystemOut.log', 'SystemErr.log', 'native_stdout.log', 'native_stderr.log'),

    # Optional path to a credential exported with Export-Clixml (DPAPI-encrypted,
    # tied to the account that will run this script) if the account running the
    # script does not already have write access to $DestinationPath.
    # Create it once, interactively, as the service account:
    #   Get-Credential | Export-Clixml C:\WebSphere\LogShipper\share.cred.xml
    [string]$CredentialPath,

    # This script's own diagnostic log (not the WebSphere logs).
    [string]$ScriptLogPath = 'C:\WebSphere\LogShipper\LogShipper.log',

    [int]$PollIntervalSeconds = 1,

    # A file must be this many milliseconds old (by LastWriteTime) before it is
    # considered stable enough to copy - guards against catching a file mid-rename
    # during rotation.
    [int]$StabilityWindowMs = 1000,

    [int]$RobocopyRetries = 3,
    [int]$RobocopyRetryWaitSeconds = 2,

    [long]$ScriptLogMaxBytes = 5MB,
    [int]$ScriptLogBackups = 5
)

$ErrorActionPreference = 'Stop'

# ---------------------------------------------------------------------------
# Single-instance guard
# ---------------------------------------------------------------------------
$mutexName = 'Global\WAS_LogShipper_' + ($SourcePath -replace '[^a-zA-Z0-9]', '_')
$mutex = New-Object System.Threading.Mutex($false, $mutexName)
if (-not $mutex.WaitOne(0)) {
    Write-Error "Another instance is already running for source '$SourcePath' (mutex '$mutexName'). Exiting."
    exit 1
}

# ---------------------------------------------------------------------------
# Logging (self-rotating so this never grows unbounded over months of uptime)
# ---------------------------------------------------------------------------
function Write-Log {
    param([string]$Message, [string]$Level = 'INFO')

    $logDir = Split-Path -Parent $ScriptLogPath
    if (-not (Test-Path -LiteralPath $logDir)) {
        New-Item -ItemType Directory -Path $logDir -Force | Out-Null
    }

    if ((Test-Path -LiteralPath $ScriptLogPath) -and
        ((Get-Item -LiteralPath $ScriptLogPath).Length -ge $ScriptLogMaxBytes)) {
        for ($i = $ScriptLogBackups; $i -ge 1; $i--) {
            $src = if ($i -eq 1) { $ScriptLogPath } else { "$ScriptLogPath.$($i - 1)" }
            $dst = "$ScriptLogPath.$i"
            if (Test-Path -LiteralPath $src) {
                Move-Item -LiteralPath $src -Destination $dst -Force
            }
        }
    }

    $line = '{0:yyyy-MM-dd HH:mm:ss.fff} [{1}] {2}' -f (Get-Date), $Level, $Message
    Add-Content -LiteralPath $ScriptLogPath -Value $line -Encoding UTF8
}

# ---------------------------------------------------------------------------
# Optional credentialed connection to the share (skip if the running account
# already has access, e.g. a domain service account granted share permissions)
# ---------------------------------------------------------------------------
$shareCredential = $null
if ($CredentialPath) {
    try {
        $shareCredential = Import-Clixml -LiteralPath $CredentialPath
    } catch {
        Write-Log "Failed to load credential from '$CredentialPath': $($_.Exception.Message)" 'ERROR'
        throw
    }
}

function Get-ShareRoot {
    param([string]$UncPath)
    # \\server\share\sub\folder -> \\server\share
    if ($UncPath -match '^(\\\\[^\\]+\\[^\\]+)') { return $Matches[1] }
    return $UncPath
}

function Connect-Share {
    if (-not $shareCredential) { return }
    $root = Get-ShareRoot -UncPath $DestinationPath
    try {
        $existing = Get-SmbMapping -RemotePath $root -ErrorAction SilentlyContinue
        if (-not $existing -or $existing.Status -ne 'OK') {
            if ($existing) { Remove-SmbMapping -RemotePath $root -Force -ErrorAction SilentlyContinue }
            New-SmbMapping -RemotePath $root -UserName $shareCredential.UserName `
                -Password $shareCredential.GetNetworkCredential().Password -Persistent $false | Out-Null
            Write-Log "Connected to share '$root'."
        }
    } catch {
        Write-Log "Could not connect to share '$root': $($_.Exception.Message)" 'ERROR'
        throw
    }
}

# ---------------------------------------------------------------------------
# Copy engine
# ---------------------------------------------------------------------------
# name+length -> $true, avoids re-touching the network for files we already
# know are copied and unchanged.
$script:CopiedCache = @{}

function Invoke-RobocopyFile {
    param([string]$SourceDir, [string]$DestDir, [string]$FileName)

    if (-not (Test-Path -LiteralPath $DestDir)) {
        New-Item -ItemType Directory -Path $DestDir -Force | Out-Null
    }

    $roboArgs = @(
        "`"$SourceDir`"", "`"$DestDir`"", "`"$FileName`"",
        '/Z',                       # restartable mode - survives network blips mid-copy
        '/R:' + $RobocopyRetries,
        '/W:' + $RobocopyRetryWaitSeconds,
        '/NP', '/NFL', '/NDL', '/NJH', '/NJS'
    )

    $proc = Start-Process -FilePath robocopy.exe -ArgumentList $roboArgs -NoNewWindow -Wait -PassThru
    # Robocopy exit codes 0-7 are success/informational; 8+ indicate real failure.
    if ($proc.ExitCode -ge 8) {
        throw "robocopy failed for '$FileName' with exit code $($proc.ExitCode)."
    }
    return $proc.ExitCode
}

function Copy-HistoricalLogFile {
    param([System.IO.FileInfo]$File)

    $cacheKey = '{0}_{1}' -f $File.Name, $File.Length
    if ($script:CopiedCache.ContainsKey($cacheKey)) { return }

    # Stability check: skip files still being written/renamed by WAS.
    $age = (Get-Date) - $File.LastWriteTime
    if ($age.TotalMilliseconds -lt $StabilityWindowMs) { return }

    $destFile = Join-Path $DestinationPath $File.Name

    if (Test-Path -LiteralPath $destFile) {
        $destInfo = Get-Item -LiteralPath $destFile
        if ($destInfo.Length -eq $File.Length) {
            # Already shipped this exact file; remember it and move on.
            $script:CopiedCache[$cacheKey] = $true
            return
        }
        # Same name, different content: WAS reused a historical file name.
        # Preserve the old content under a timestamped name before overwriting.
        $archiveName = '{0}.{1}{2}' -f `
            [IO.Path]::GetFileNameWithoutExtension($File.Name), `
            (Get-Date -Format 'yyyyMMdd_HHmmss'), `
            [IO.Path]::GetExtension($File.Name)
        $archivePath = Join-Path $DestinationPath $archiveName
        Rename-Item -LiteralPath $destFile -NewName $archiveName -Force
        Write-Log "Destination name collision on '$($File.Name)' - archived previous copy as '$archiveName'."
    }

    $exitCode = Invoke-RobocopyFile -SourceDir $File.DirectoryName -DestDir $DestinationPath -FileName $File.Name
    Write-Log "Shipped '$($File.Name)' ($($File.Length) bytes, robocopy exit $exitCode)."
    $script:CopiedCache[$cacheKey] = $true
}

function Invoke-ShipCycle {
    if (-not (Test-Path -LiteralPath $SourcePath)) {
        Write-Log "Source path '$SourcePath' not reachable this cycle." 'WARN'
        return
    }

    Connect-Share

    if (-not (Test-Path -LiteralPath $DestinationPath)) {
        Write-Log "Destination '$DestinationPath' not reachable this cycle." 'WARN'
        return
    }

    $candidates = Get-ChildItem -LiteralPath $SourcePath -File -ErrorAction SilentlyContinue |
        Where-Object { $ExcludeFileNames -notcontains $_.Name }

    foreach ($file in $candidates) {
        try {
            Copy-HistoricalLogFile -File $file
        } catch {
            Write-Log "Failed to ship '$($file.Name)': $($_.Exception.Message)" 'ERROR'
        }
    }
}

# ---------------------------------------------------------------------------
# Main loop - runs forever, one pass per $PollIntervalSeconds, never exits on
# a transient error. Only Ctrl+C / service stop / host crash ends it, and the
# service wrapper (see bottom notes) is responsible for restarting it if so.
# ---------------------------------------------------------------------------
try {
    Write-Log "LogShipper started. Source='$SourcePath' Destination='$DestinationPath' Interval=${PollIntervalSeconds}s"

    while ($true) {
        $cycleStart = Get-Date
        try {
            Invoke-ShipCycle
        } catch {
            Write-Log "Unhandled error in ship cycle: $($_.Exception.Message)" 'ERROR'
        }

        $elapsed = ((Get-Date) - $cycleStart).TotalSeconds
        $sleepFor = $PollIntervalSeconds - $elapsed
        if ($sleepFor -gt 0) {
            Start-Sleep -Seconds $sleepFor
        }
    }
} finally {
    Write-Log 'LogShipper stopping.'
    $mutex.ReleaseMutex() | Out-Null
    $mutex.Dispose()
}
